                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 80%;">
                                </div>
                            </div>
                            <span class="time-stamp">2:45</span>
                        </div>
                        <div class="player-controls">
                            <button class="control-btn" aria-label="Anterior"
                                >⏮</button
                            >
                            <button
